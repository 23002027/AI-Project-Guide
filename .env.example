# ==============================================================================
# AI Project & Hackathon Co-Pilot — Environment Configuration Template
# COPY THIS FILE TO backend/.env AND FILL IN YOUR ACTUAL CREDENTIALS.
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL!
# ==============================================================================

# ── AI Provider Selection ──────────────────────────────────────────────────────
# Set to 'gemini' (recommended, default) or 'claude' (legacy fallback)
AI_PROVIDER=gemini

# ── Google Gemini AI Configuration (Primary) ───────────────────────────────────
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# ── Anthropic Claude AI Configuration (Secondary / Legacy Fallback) ────────────
# Get your API key from: https://console.anthropic.com/
# Leave empty if only using Gemini
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Security & Authentication ──────────────────────────────────────────────────
# Change to a strong random secret key in production!
JWT_SECRET_KEY=copilot-production-jwt-secret-key-change-me-in-prod-2026

# ── Database Persistence ───────────────────────────────────────────────────────
# Default SQLite database path (or use an absolute path)
DATABASE_PATH=backend/data/copilot.db

# ── GitHub Integration (Optional) ─────────────────────────────────────────────
# Personal Access Token with 'repo' scope
# Leave empty to use local offline project scaffolding
GITHUB_TOKEN=

# ── Application Settings ───────────────────────────────────────────────────────
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# ── CORS Origins ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
